<section id="hero-<%= model.id %>" class="hero-vota">
  <div class="hero-vota__content">
    <span class="hero-vota__badge">
      <%= translated_attribute(model.settings.badge_text).presence || t("decidim.pages.home.hero.badge_text") %>
    </span>

    <h1 class="hero-vota__title">
      <% if translated_welcome_up_text.present? %>
        <%= decidim_sanitize_admin translated_welcome_up_text %>
      <% else %>
        <%= t("decidim.pages.home.hero.welcome", organization: current_organization_name) %>
      <% end %>
    </h1>

    <% if translated_welcome_text.present? %>
      <p class="hero-vota__subtitle"><%= decidim_sanitize_admin translated_welcome_text %></p>
    <% end %>

    <div class="hero-vota__actions">
      <%= link_to cta_button_text, cta_button_path, id: "hero-cta", class: "hero-vota__cta", title: t("decidim.pages.home.hero.participate_title") %>
    </div>
  </div>

  <div class="hero-vota__image">
    <% if model.images_container.background_image&.attached? %>
      <%= image_tag background_image, alt: "" %>
    <% else %>
      <%= image_pack_tag "media/images/vota.jpg", alt: "" %>
    <% end %>
  </div>
</section>
